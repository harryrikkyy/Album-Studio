+  if (/^\/fixture\/sample\/[0-5]\.svg$/.test(url.pathname)) {
+    return send('image/svg+xml', '<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400"><rect width="600" height="400" fill="#92715d"/><circle cx="180" cy="160" r="90" fill="#d8bc95"/><circle cx="400" cy="190" r="130" fill="#6c7d68"/><path d="M0 400L300 210 600 400" fill="#4b5751"/></svg>')
+  }
+  res.writeHead(404).end()
+}).listen(5191, '127.0.0.1', () => console.log('Synthetic UI preview: http://127.0.0.1:5191/?open=/album (large=1; scenario=empty|offline|storage-error)'))
+
+// Check the ordinary fixture through the same wire validator used in production.
+validateReply('album.open', { id: 1, ok: true, result: fixture(36) })
