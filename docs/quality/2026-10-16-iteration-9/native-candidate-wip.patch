@@ -0,0 +1,175 @@
+use super::*;
+use std::io::{BufRead, BufReader, Write};
+use std::process::{Child, Command, Stdio};
+use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+struct Fixture {
+    child: Child,
+    root: PathBuf,
+}
+impl Drop for Fixture {
+    fn drop(&mut self) {
+        if let Some(mut stdin) = self.child.stdin.take() {
+            let _ = writeln!(stdin, "release");
+        }
+        let deadline = Instant::now() + Duration::from_secs(3);
+        while Instant::now() < deadline {
+            if matches!(self.child.try_wait(), Ok(Some(_))) {
+                break;
+            }
+            std::thread::sleep(Duration::from_millis(5));
+        }
+        if !matches!(self.child.try_wait(), Ok(Some(_))) {
+            let _ = self.child.kill();
+            let _ = self.child.wait();
+        }
+        let _ = std::fs::remove_dir_all(&self.root);
+    }
+}
+
+#[test]
+fn document_writer_cannot_replace_a_sheet_while_backend_owns_the_album_and_output() {
+    let root =
+        std::env::temp_dir().join(format!("as-native-save-owner-{}-{}", std::process::id(), SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos()));
+    std::fs::create_dir(&root).unwrap();
+    let album = root.join("Album");
+    let output = root.join("Sheets");
+    std::fs::create_dir(&album).unwrap();
+    std::fs::create_dir(&output).unwrap();
+    let project = album.join("project.json");
+    std::fs::write(
+        &project,
+        serde_json::to_vec(&serde_json::json!({"version":1,"totalActivePages":0,"albumPages":{},"workspace":{"outputToken":output}})).unwrap(),
+    )
+    .unwrap();
+    let sheet = output.join("Page_001.psd");
+    let original = b"existing manual sheet bytes";
+    std::fs::write(&sheet, original).unwrap();
+    let script = crate::resources::backend_script().parent().unwrap().join("test/fixtures/native-output-owner.cjs");
+    assert!(script.is_file(), "Use ALBUM_STUDIO_BACKEND for the root helper while testing the isolated candidate.");
+    let child = Command::new(crate::resources::node())
+        .arg(script)
+        .arg(&project)
+        .arg(&output)
+        .stdin(Stdio::piped())
+        .stdout(Stdio::piped())
+        .stderr(Stdio::inherit())
+        .spawn()
+        .unwrap();
+    let mut fixture = Fixture { child, root };
+    let mut response = String::new();
+    BufReader::new(fixture.child.stdout.take().unwrap()).read_line(&mut response).unwrap();
+    let ready: serde_json::Value = serde_json::from_str(&response).unwrap();
+    assert_eq!(ready["ready"], true, "{ready}");
+    let mut services = native_with_recovery(None, None);
+    let result = services.write.as_mut().unwrap()(sheet.to_str().unwrap(), b"racing native save");
+    let after = std::fs::read(&sheet).unwrap();
+    assert_eq!(after, original, "The production native document writer replaced a sheet while both backend capabilities were held.");
+    assert!(result.is_err(), "A blocked publication must also report failure to the native caller.");
+}
+
+struct Scratch(PathBuf);
+impl Scratch {
+    fn new() -> Self {
+        let root = std::env::temp_dir().join(format!(
+            "as-native-publication-{}-{}",
+            std::process::id(),
+            SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos()
+        ));
+        std::fs::create_dir(&root).unwrap();
+        Self(root)
+    }
+}
+impl Drop for Scratch {
+    fn drop(&mut self) {
+        let _ = std::fs::remove_dir_all(&self.0);
+    }
+}
+
+#[test]
+fn native_writer_commits_existing_and_new_documents_and_releases_its_worker() {
+    let scratch = Scratch::new();
+    let path = scratch.0.join("manual.psd");
+    std::fs::write(&path, b"original manual layers").unwrap();
+    let mut services = native_with_recovery(None, None);
+    let write = services.write.as_mut().unwrap();
+    write(path.to_str().unwrap(), b"first encoded native save").unwrap();
+    assert_eq!(std::fs::read(&path).unwrap(), b"first encoded native save");
+    write(path.to_str().unwrap(), b"second encoded native save").unwrap();
+    assert_eq!(std::fs::read(&path).unwrap(), b"second encoded native save");
+    let new = scratch.0.join("copy.psd");
+    write(new.to_str().unwrap(), b"saved copy").unwrap();
+    assert_eq!(std::fs::read(new).unwrap(), b"saved copy");
+    let histories = std::fs::read_dir(scratch.0.join(".album-studio-publications/history")).unwrap().count();
+    assert_eq!(histories, 3);
+}
+
+#[test]
+fn native_cancel_after_preparation_preserves_the_target_and_retry_reclaims_only_the_dead_worker() {
+    let scratch = Scratch::new();
+    let path = scratch.0.join("manual.psd");
+    std::fs::write(&path, b"customer original").unwrap();
+    let publisher = publication::Publication::prepare(path.to_str().unwrap()).unwrap();
+    let result = publisher.publish(b"cancelled encoded bytes", || Ok(()), || Err("cancelled before commit".into()));
+    assert_eq!(result.unwrap_err(), "cancelled before commit");
+    assert_eq!(std::fs::read(&path).unwrap(), b"customer original");
+    publication::Publication::prepare(path.to_str().unwrap()).unwrap().publish(b"successful retry", || Ok(()), || Ok(())).unwrap();
+    assert_eq!(std::fs::read(path).unwrap(), b"successful retry");
+}
+
+#[test]
+fn native_worker_rejects_an_earlier_decoder_revision_after_a_manual_edit() {
+    let scratch = Scratch::new();
+    let path = scratch.0.join("manual.psd");
+    let revision = photocraft_engine::source_revision::SourceRevision::from_bytes(b"decoder input bytes");
+    std::fs::write(&path, b"new customer manual edits").unwrap();
+    let expected = serde_json::json!({"mode":"source","digest":revision.sha256(),"size":revision.byte_length().to_string()});
+    let result = publication::Publication::prepare_expected(path.to_str().unwrap(), expected);
+    assert!(result.is_err());
+    assert!(result.err().unwrap().contains("PUBLICATION_CONFLICT"));
+    assert_eq!(std::fs::read(path).unwrap(), b"new customer manual edits");
+}
+
+#[test]
+fn actual_ui_sync_and_background_saves_use_native_publication_and_keep_document_identity() {
+    use photocraft_ui_egui::PhotocraftApp;
+    for background in [false, true] {
+        let scratch = Scratch::new();
+        let path = scratch.0.join("作品.psd");
+        let target = path.to_str().unwrap().to_string();
+        let mut platform = native_with_recovery(None, None);
+        // Only document services: no real user preferences, presets, recovery,
+        // dialogs or graphical window are involved in this headless integration.
+        let services = Services {
+            import: platform.import.take(),
+            export: platform.export.take(),
+            write: platform.write.take(),
+            save_file: platform.save_file.take(),
+            ..Default::default()
+        };
+        let mut app = PhotocraftApp::new(photocraft_engine::Session::new(), services);
+        app.background_jobs = background;
+        app.run("file.new", serde_json::json!({"width":4,"height":4,"name":"Untitled-1"})).unwrap();
+        app.run("layer.new.layer", serde_json::json!({})).unwrap();
+        let id = app.session.active().unwrap().doc.id;
+        let revision = app.session.active().unwrap().revision;
+        app.save_as(Some(target.clone())).unwrap();
+        let deadline = Instant::now() + Duration::from_secs(15);
+        let context = egui::Context::default();
+        while app.session.active().unwrap().path.as_deref() != Some(target.as_str()) {
+            photocraft_ui_egui::jobs_ui::tick(&mut app, &context);
+            assert!(!app.ui.status_error, "{}", app.ui.status);
+            assert!(Instant::now() < deadline, "native UI save did not finish: {}", app.ui.status);
+            std::thread::sleep(Duration::from_millis(2));
+        }
+        let state = app.session.active().unwrap();
+        assert_eq!(state.doc.id, id);
+        assert_eq!(state.revision, revision);
+        assert_eq!(state.saved_revision, revision);
+        assert_eq!(state.doc.name, "作品.psd");
+        let bytes = std::fs::read(&path).unwrap();
+        let reopened = photocraft_io::import("作品.psd", &bytes).unwrap();
+        assert_eq!(reopened.document.size, state.doc.size);
+        assert_eq!(std::fs::read_dir(scratch.0.join(".album-studio-publications/history")).unwrap().count(), 1);
+    }
+}
