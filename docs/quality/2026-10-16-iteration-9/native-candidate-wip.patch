index 0000000..daf343b
--- /dev/null
+++ b/apps/album-studio/src/services/publication.rs
@@ -0,0 +1,188 @@
+//! Private native publication adapter. The Node worker owns both leases and I/O.
+//! Preparation is cancellable; the final commit decision is explicit. Dropping
+//! this adapter closes admission, kills/reaps its worker and joins both threads.
+use photocraft_engine::source_revision::SourceRevision;
+use serde_json::{Value, json};
+use std::io::{BufRead, BufReader, Read, Write};
+use std::process::{Child, ChildStdin, Command, Stdio};
+use std::sync::{Arc, Mutex, mpsc};
+use std::thread::JoinHandle;
+use std::time::Duration;
+
+const MAX_FRAME: usize = 65536;
+const ADMISSION: Duration = Duration::from_secs(30);
+const OPERATION: Duration = Duration::from_secs(6 * 60 * 60);
+
+pub(super) struct Publication {
+    child: Arc<Mutex<Child>>,
+    input: Option<ChildStdin>,
+    replies: mpsc::Receiver<Result<Value, String>>,
+    reader: Option<JoinHandle<()>>,
+    watchdog: Option<JoinHandle<()>>,
+    stop: Option<mpsc::Sender<()>>,
+}
+impl Publication {
+    pub(super) fn prepare(path: &str) -> Result<Self, String> {
+        Self::prepare_expected(path, json!({"mode":"overwrite"}))
+    }
+    // The explicit expectation supports earlier decoder/receipt records without
+    // granting an ambient caller permission to silently adopt newer contents.
+    pub(super) fn prepare_expected(path: &str, expected: Value) -> Result<Self, String> {
+        let mut command = Command::new(crate::resources::node());
+        if let Some(cli) = crate::resources::photocraft_cli()
+            && std::env::var_os("ALBUM_STUDIO_PHOTOCRAFT_CLI").is_none()
+        {
+            command.env("ALBUM_STUDIO_PHOTOCRAFT_CLI", cli);
+        }
+        let mut child = command
+            .arg(crate::resources::backend_script())
+            .arg("--native-publication")
+            .stdin(Stdio::piped())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::inherit())
+            .spawn()
+            .map_err(|e| format!("Could not start the file publication worker: {e}"))?;
+        let input = child.stdin.take().ok_or("The publication worker has no input pipe.")?;
+        let output = child.stdout.take().ok_or("The publication worker has no reply pipe.")?;
+        let child = Arc::new(Mutex::new(child));
+        let (tx, replies) = mpsc::sync_channel(4);
+        let reader = match std::thread::Builder::new().name("publication replies".into()).spawn(move || {
+            let mut output = BufReader::new(output);
+            // At most ready/prepared/final. Bound unsolicited replies as well as
+            // each frame, so a failed or incompatible helper cannot grow memory.
+            for _ in 0..4 {
+                let mut bytes = Vec::new();
+                let result = (&mut output).take((MAX_FRAME + 1) as u64).read_until(b'\n', &mut bytes);
+                let reply: Result<Value, String> = match result {
+                    Ok(0) => Err("The file publication worker closed its reply pipe. Verify the target and retained history before retrying.".into()),
+                    Ok(_) if bytes.len() > MAX_FRAME || bytes.last() != Some(&b'\n') => {
+                        Err("The file publication reply was oversized or incomplete. Verify the target before retrying.".into())
+                    }
+                    Ok(_) => serde_json::from_slice(&bytes).map_err(|e| format!("Invalid file publication reply: {e}")),
+                    Err(e) => Err(format!("Could not read the file publication reply: {e}")),
+                };
+                let terminal = reply.is_err() || reply.as_ref().ok().and_then(|v| v["state"].as_str()).is_some_and(|s| s == "failed" || s == "committed");
+                if tx.try_send(reply).is_err() || terminal {
+                    break;
+                }
+            }
+        }) {
+            Ok(reader) => reader,
+            Err(e) => {
+                if let Ok(mut child) = child.lock() {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                }
+                return Err(format!("Could not read file publication replies: {e}"));
+            }
+        };
+        let (stop, stopped) = mpsc::channel();
+        let watched = Arc::clone(&child);
+        let watchdog = match std::thread::Builder::new().name("publication deadline".into()).spawn(move || {
+            if matches!(stopped.recv_timeout(OPERATION), Err(mpsc::RecvTimeoutError::Timeout))
+                && let Ok(mut child) = watched.lock()
+            {
+                let _ = child.kill();
+            }
+        }) {
+            Ok(watchdog) => watchdog,
+            Err(e) => {
+                if let Ok(mut child) = child.lock() {
+                    let _ = child.kill();
+                    let _ = child.wait();
+                }
+                let _ = reader.join();
+                return Err(format!("Could not guard the file publication deadline: {e}"));
+            }
+        };
+        let mut worker = Self { child, input: Some(input), replies, reader: Some(reader), watchdog: Some(watchdog), stop: Some(stop) };
+        worker.header(&json!({"version":1,"target":path,"expected":expected}))?;
+        worker.expect("ready", ADMISSION)?;
+        Ok(worker)
+    }
+    fn header(&mut self, value: &Value) -> Result<(), String> {
+        let bytes = serde_json::to_vec(value).map_err(|e| e.to_string())?;
+        if bytes.is_empty() || bytes.len() > MAX_FRAME {
+            return Err("The file publication header exceeds its 64 KiB limit.".into());
+        }
+        let input = self.input.as_mut().ok_or("The file publication input is closed.")?;
+        input
+            .write_all(&(bytes.len() as u32).to_be_bytes())
+            .and_then(|_| input.write_all(&bytes))
+            .map_err(|e| format!("Could not send the file publication request: {e}"))
+    }
+    fn expect(&self, state: &str, timeout: Duration) -> Result<Value, String> {
+        let reply = self
+            .replies
+            .recv_timeout(timeout)
+            .map_err(|e| format!("The file publication reply did not arrive: {e}. Verify the target and retained history before retrying."))??;
+        if reply["version"] != 1 {
+            return Err("The file publication worker uses an unsupported protocol. Verify the target before retrying.".into());
+        }
+        if reply["state"] == "failed" {
+            let error = &reply["error"];
+            let mut message =
+                format!("{}: {}", error["code"].as_str().unwrap_or("PUBLICATION_FAILED"), error["message"].as_str().unwrap_or("File publication failed."));
+            if let Some(stage) = error["recoveryStage"].as_str() {
+                message.push_str(&format!(" Recovery evidence: {stage}."));
+            }
+            if error["publicationCommitted"] == true {
+                message.push_str(" The publication committed; verify its current bytes before retrying.");
+            }
+            if error["recoveryRequired"] == true {
+                message.push_str(" Recovery requires review; preserve all versions.");
+            }
+            return Err(message);
+        }
+        if reply["state"] != state {
+            return Err(format!("Unexpected file publication state while waiting for {state}; verify the target before retrying."));
+        }
+        Ok(reply)
+    }
+    pub(super) fn publish(
+        mut self,
+        bytes: &[u8],
+        mut check: impl FnMut() -> Result<(), String>,
+        commit: impl FnOnce() -> Result<(), String>,
+    ) -> Result<(), String> {
+        check()?;
+        let source = SourceRevision::from_bytes(bytes);
+        self.header(&json!({"length":source.byte_length(),"digest":source.sha256()}))?;
+        for chunk in bytes.chunks(1024 * 1024) {
+            check()?;
+            self.input
+                .as_mut()
+                .ok_or("The file publication input is closed.")?
+                .write_all(chunk)
+                .map_err(|e| format!("Could not stream the encoded document: {e}"))?;
+        }
+        self.expect("prepared", OPERATION)?;
+        check()?;
+        commit()?;
+        self.header(&json!({"commit":true}))?;
+        drop(self.input.take());
+        let reply = self.expect("committed", OPERATION)?;
+        if reply["result"]["committed"] != true {
+            return Err("The file publication receipt did not confirm commit. Verify the target before retrying.".into());
+        }
+        Ok(())
+    }
+}
+impl Drop for Publication {
+    fn drop(&mut self) {
+        drop(self.input.take());
+        drop(self.stop.take());
+        if let Ok(mut child) = self.child.lock() {
+            if !matches!(child.try_wait(), Ok(Some(_))) {
+                let _ = child.kill();
+            }
+            let _ = child.wait();
+        }
+        if let Some(reader) = self.reader.take() {
+            let _ = reader.join();
+        }
+        if let Some(watchdog) = self.watchdog.take() {
+            let _ = watchdog.join();
+        }
+    }
+}
