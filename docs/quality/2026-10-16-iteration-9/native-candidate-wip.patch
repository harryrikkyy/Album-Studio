+//! Immutable evidence for bytes actually consumed during import. Filesystem identity,
+//! album association, write authority and later publication receipts are separate concerns.
+use sha2::{Digest, Sha256};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct SourceRevision {
+    sha256: String,
+    byte_length: u64,
+}
+impl SourceRevision {
+    /// Hash the supplied decoder input; never reopen a possibly changed pathname.
+    pub fn from_bytes(bytes: &[u8]) -> Self {
+        Self { sha256: format!("{:x}", Sha256::digest(bytes)), byte_length: bytes.len() as u64 }
+    }
+    pub fn sha256(&self) -> &str {
+        &self.sha256
+    }
+    pub fn byte_length(&self) -> u64 {
+        self.byte_length
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{Session, file_cmds, jobs::OpenSource};
+    use std::sync::Arc;
+    use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
+
+    fn source() -> Vec<u8> {
+        let mut session = Session::new();
+        session.execute("file.new", serde_json::json!({"name":"Source","width":2,"height":2})).unwrap();
+        photocraft_format::save_to_bytes(&session.active().unwrap().doc, &Default::default()).unwrap()
+    }
+    #[test]
+    fn sha256_matches_the_standard_cross_runtime_vector() {
+        let revision = SourceRevision::from_bytes(b"abc");
+        assert_eq!(revision.sha256(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad");
+        assert_eq!(revision.byte_length(), 3);
+        assert_ne!(revision, SourceRevision::from_bytes(b"abd"));
+    }
+    #[test]
+    fn synchronous_import_binds_decoder_bytes_without_reopening_the_given_path() {
+        let bytes = source();
+        let mut session = Session::new();
+        file_cmds::open_bytes_as(&mut session, "source.pcraft", &bytes, None, Some("/a/path/that/was/not/read.pcraft".into())).unwrap();
+        assert_eq!(session.active().unwrap().decoded_source.as_ref(), Some(&SourceRevision::from_bytes(&bytes)));
+    }
+    #[test]
+    fn background_byte_and_path_imports_keep_the_consumed_revision_after_external_replacement() {
+        let bytes = source();
+        let root =
+            std::env::temp_dir().join(format!("as-decoded-source-{}-{}", std::process::id(), SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos()));
+        std::fs::create_dir(&root).unwrap();
+        let file = root.join("source.pcraft");
+        for from_path in [false, true] {
+            std::fs::write(&file, &bytes).unwrap();
+            let input = if from_path { OpenSource::Path(file.to_str().unwrap().into()) } else { OpenSource::Bytes(Arc::new(bytes.clone())) };
+            let mut session = Session::new();
+            session.start_open("source.pcraft", input).unwrap();
+            let deadline = Instant::now() + Duration::from_secs(10);
+            while session.active().is_none() {
+                for event in session.poll_jobs() {
+                    assert!(!matches!(event.outcome, crate::jobs::JobOutcome::Failed(_)), "{event:?}");
+                }
+                assert!(Instant::now() < deadline, "source import did not complete");
+                std::thread::sleep(Duration::from_millis(2));
+            }
+            std::fs::write(&file, b"a later external replacement").unwrap();
+            assert_eq!(session.active().unwrap().decoded_source.as_ref(), Some(&SourceRevision::from_bytes(&bytes)));
+            assert_ne!(session.active().unwrap().decoded_source.as_ref(), Some(&SourceRevision::from_bytes(&std::fs::read(&file).unwrap())));
+        }
+        std::fs::remove_dir_all(root).unwrap();
+    }
+}
