+#[test]
+fn both_ui_import_modes_bind_the_decoder_bytes_to_the_loaded_document() {
+    use photocraft_engine::source_revision::SourceRevision;
+    use std::time::{Duration, Instant};
+    for background in [false, true] {
+        let mut app = app();
+        let mut bytes = photocraft_io::export(&app.session.active().unwrap().doc, "source.psd", &Default::default()).unwrap().bytes;
+        let expected = SourceRevision::from_bytes(&bytes);
+        let count = app.session.documents().len();
+        app.background_jobs = background;
+        app.open_file("/source/that/is/not/reopened.psd", &bytes).unwrap();
+        bytes.fill(0);
+        let deadline = Instant::now() + Duration::from_secs(10);
