{
  "name": "album-studio",
  "productName": "Album Studio",
  "version": "1.0.0",
  "private": true,
  "description": "Album Studio by Creative Hubb: plan, render, edit and deliver photo albums on the Mac. A native app: the PhotoCraft editor and engine, a web interface, and a Node.js helper. No Photoshop.",
  "license": "MIT",
  "scripts": {
    "check:architecture": "node native/scripts/check-architecture.mjs",
    "pretest": "npm run check:architecture",
    "build": "native/scripts/package-mac.sh",
    "start": "open \"native/dist/Album Studio.app\"",
    "test": "node --test test/*.test.js && npm --prefix native/backend test && npm --prefix native/ui test",
    "test:shared": "node --test test/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.js",
    "lint": "eslint \"src/**/*.js\" \"test/**/*.js\" \"native/backend/**/*.js\" \"native/contracts/**/*.js\"",
    "typecheck": "tsc --noEmit && npm --prefix native/ui run typecheck"
  },
  "dependencies": {
    "ag-psd": "^31.0.2",
    "node-machine-id": "^1.1.12",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "eslint": "^8.57.0",
    "typescript": "^6.0.3"
  }
}
